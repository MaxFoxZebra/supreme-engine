{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CV Studio",
  "version": "0.2.0",
  "identifier": "dev.cvstudio.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "server-dist/**/*"
    ],
    "shortDescription": "Local RenderCV editor",
    "longDescription": "A local editor for RenderCV CV files with live preview, theme switching and page-budget feedback. Runs entirely on your machine.",
    "publisher": "CV Studio",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Maxime Bidault. MIT licensed.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "compression": "lzma",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMjY5OEEzOTMwMjUzRDkKUldUWlV3S1RvNWdtRWFzdjcvN2RuakhtYlNieWczdldTVTI2eXdrK2xXcEcwMDlBS2ZITUhGN1YK",
      "endpoints": [
        "https://github.com/MaxFoxZebra/supreme-engine/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
